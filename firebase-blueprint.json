{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profiles linked to Firebase Auth UID with role-based access and tenant isolation",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "User full name" },
        "email": { "type": "string", "description": "User email address" },
        "phone": { "type": "string", "description": "User contact phone number" },
        "role": { "type": "string", "description": "User role: Owner, Manager, Cashier, Kitchen, Accountant" },
        "restaurantId": { "type": "string", "description": "ID of the restaurant this user belongs to" },
        "restaurantName": { "type": "string", "description": "Restaurant name" },
        "branchId": { "type": "string", "description": "Assigned branch ID" },
        "isPlatformOwner": { "type": "boolean", "description": "Super admin flag for platform creator" },
        "isActive": { "type": "boolean", "description": "Whether user account is active" },
        "createdAt": { "type": "string", "description": "Account creation timestamp" },
        "lastLoginAt": { "type": "string", "description": "Last login timestamp" }
      },
      "required": ["uid", "name", "email", "role", "restaurantId"]
    },
    "restaurants": {
      "title": "Restaurants",
      "description": "Registered restaurants, owners, contact numbers, subscription expiry and activation codes",
      "properties": {
        "name": { "type": "string", "description": "Restaurant Name" },
        "ownerName": { "type": "string", "description": "Owner Name" },
        "phone": { "type": "string", "description": "Phone number" },
        "email": { "type": "string", "description": "Email address" },
        "status": { "type": "string", "description": "Status: active or expired or pending" },
        "activationCode": { "type": "string", "description": "Annual activation code" },
        "subscriptionExpiry": { "type": "string", "description": "Subscription Expiry Date ISO string" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["name", "phone", "status"]
    },
    "restaurant_data": {
      "title": "Restaurant Data & Menu Sync",
      "description": "Full multi-device cloud synchronization state for restaurant products, categories, recipes, ingredients, orders, expenses, and operational records",
      "properties": {
        "restaurantId": { "type": "string", "description": "Restaurant Unique ID" },
        "products": { "type": "array", "description": "List of products and menu items" },
        "categories": { "type": "array", "description": "List of categories" },
        "ingredients": { "type": "array", "description": "List of raw materials and inventory" },
        "recipes": { "type": "array", "description": "List of product cost recipes" },
        "orders": { "type": "array", "description": "List of sales orders" },
        "expenses": { "type": "array", "description": "List of operational expenses" },
        "suppliers": { "type": "array", "description": "List of suppliers" },
        "purchases": { "type": "array", "description": "List of supplier purchase invoices" },
        "stockMovements": { "type": "array", "description": "List of stock adjustments and waste" },
        "branches": { "type": "array", "description": "List of restaurant branches" },
        "restaurant": { "type": "object", "description": "Restaurant branding and metadata" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["restaurantId"]
    },
    "staff_requests": {
      "title": "Staff Requests",
      "description": "Staff registration and role approval requests",
      "properties": {
        "name": { "type": "string", "description": "Staff member name" },
        "emailOrPhone": { "type": "string", "description": "Email or phone" },
        "role": { "type": "string", "description": "Role requested" },
        "restaurantId": { "type": "string", "description": "Restaurant ID" },
        "status": { "type": "string", "description": "pending, approved, or rejected" }
      },
      "required": ["name", "emailOrPhone", "restaurantId", "status"]
    },
    "activation_codes": {
      "title": "Activation Codes",
      "description": "Generated annual activation codes",
      "properties": {
        "code": { "type": "string", "description": "Activation code e.g. MATO-2026-XXXX" },
        "restaurantId": { "type": "string", "description": "ID of the restaurant" },
        "restaurantName": { "type": "string", "description": "Name of the restaurant" },
        "status": { "type": "string", "description": "active or redeemed" },
        "expiresAt": { "type": "string", "description": "Expiration date" },
        "generatedAt": { "type": "string", "description": "Timestamp code was generated" }
      },
      "required": ["code", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile with role-based attributes and tenant linkage"
    },
    "/restaurants/{restaurantId}": {
      "schema": "restaurants",
      "description": "Registered restaurants directory with subscription details"
    },
    "/restaurant_data/{restaurantId}": {
      "schema": "restaurant_data",
      "description": "Isolated per-restaurant database document for categories, products, stock, orders, and sales"
    },
    "/staff_requests/{requestId}": {
      "schema": "staff_requests",
      "description": "Pending staff join requests"
    },
    "/activation_codes/{codeId}": {
      "schema": "activation_codes",
      "description": "Annual activation codes pool"
    }
  }
}
